# =============================================================================
# Server-only — never prefix with NEXT_PUBLIC_ (not exposed to the browser)
# =============================================================================

# Local development (default if unset: http://localhost:8080)
# Use 127.0.0.1 (not localhost) to avoid IPv6 proxy connection resets.
API_PROXY_TARGET=http://127.0.0.1:8080

# Production — REQUIRED. Set on your hosting platform (Vercel, Docker, etc.):
# API_PROXY_TARGET=https://api.yourdomain.com
#
# The browser only calls /api/* on your frontend domain. Next.js proxies
# server-side to API_PROXY_TARGET. No CORS, backend URL stays server-side.
